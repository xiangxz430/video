# ============================================================
# 生产环境变量模板（仅供参考）
#
# ⚠️ 此文件不会被应用程序自动加载，仅作为配置模板参考。
# ⚠️ 生产部署时请直接编辑 .env 文件，填入实际值。
# ⚠️ 不要执行 cp .env.production .env，直接维护 .env 即可。
# ============================================================

# ---------- 服务基础配置 ----------

# [必填] 服务监听端口
PORT=3000

# [必填] 服务器API密钥，客户端请求时需携带此密钥进行认证
# 请生成一个强密码，例如：openssl rand -hex 32
API_KEY=

# [必填] 管理员密钥，用于管理后台登录及API密钥管理
# 请生成一个强密码，例如：openssl rand -hex 32
ADMIN_KEY=

# ---------- DeepSeek（剧本生成/分镜生成） ----------

# [可选] DeepSeek API密钥，用于剧本生成和分镜生成
DEEPSEEK_API_KEY=

# [可选] DeepSeek API地址，默认 https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 火山引擎 Volcengine ----------

# [可选] 火山引擎API密钥
VOLCENGINE_API_KEY=

# [可选] 火山引擎API地址，默认 https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---------- GRSAI ----------

# [可选] GRSAI API密钥
GRSAI_API_KEY=

# [可选] GRSAI API地址，默认 https://grsai.dakka.com.cn
GRSAI_BASE_URL=https://grsai.dakka.com.cn

# ---------- OpenRouter ----------

# [可选] OpenRouter API密钥，可访问多种模型
OPENROUTER_API_KEY=

# [可选] OpenRouter API地址，默认 https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------- IdeLab ----------

# [可选] IdeLab API密钥，用于图片生成
IDEALAB_API_KEY=

# [可选] IdeLab API地址（无默认值，需按服务商提供的地址填写）
IDEALAB_BASE_URL=

# ---------- 通义千问 Qwen ----------

# [可选] 通义千问API密钥
QWEN_API_KEY=

# [可选] 通义千问API地址，默认 https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- TokenPlan ----------

# [可选] TokenPlan API密钥
TOKENPLAN_API_KEY=

# [可选] TokenPlan API地址，默认 https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
TOKENPLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ---------- 百炼 DashScope (视频生成) ----------

# [可选] 百炼 DashScope API密钥，用于视频生成 (Wan2.7, HappyHorse)
DASHSCOPE_API_KEY=

# [可选] 百炼 DashScope API地址，默认 https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
