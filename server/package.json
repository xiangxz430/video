{
  "name": "video-generator-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build:admin": "cd admin && npm install && npm run build",
    "build": "npm run build:admin && tsc",
    "start": "node dist/app.js",
    "deploy": "bash deploy/deploy.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart video-server",
    "pm2:stop": "pm2 stop video-server",
    "pm2:logs": "pm2 logs video-server"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
